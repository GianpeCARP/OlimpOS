# =============================================================================
# backend/.env.example — plantilla de configuración
# =============================================================================
# Copiá este archivo como `.env` (sin el .example) y completá los valores.
# El .env real NUNCA se sube: el .gitignore de la raíz lo bloquea, y este
# .example existe justamente para que el repo documente QUÉ variables hacen
# falta sin filtrar ninguna.
#
#   cp .env.example .env      (Git Bash)
#   Copy-Item .env.example .env   (PowerShell)


# --- Base de datos -----------------------------------------------------------
# Cadena de conexión de Neon: panel de Neon -> Connection string -> psycopg2.
# El sslmode=require es obligatorio, Neon rechaza conexiones sin cifrar.
#
# Cuando esto se mude a un servidor local del gimnasio, lo ÚNICO que cambia
# es esta línea (ej. postgresql://olimpos:...@192.168.1.10:5432/olimpos).
# Por eso la cadena vive acá y no hardcodeada en database.py.
DATABASE_URL=postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/olimpos?sslmode=require


# --- Sesiones (JWT) ----------------------------------------------------------
# Clave con la que se firman los tokens. Si cambia, todas las sesiones
# abiertas quedan invalidadas. Generá una larga y aleatoria con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=generar-una-clave-larga-y-aleatoria-no-usar-esta

# Duración de la sesión en minutos (480 = 8 horas, igual que el ref del profe).
JWT_EXPIRACION_MINUTOS=480


# --- Dueño inicial (bootstrapping) -------------------------------------------
# El seeder crea esta cuenta UNA sola vez, si no existe ningún Dueño.
# Norma explícita del profe: nunca hardcodear un admin@gym.com / 12345 en el
# código, porque si el fuente se filtra se filtra también la llave maestra.
#
# La cuenta nace con debe_cambiar_password = true: el dueño entra con esta
# clave, el backend le NIEGA el token, lo manda a cambiarla, y recién en el
# segundo login entra de verdad.
DUENO_INICIAL_DNI=00000000
DUENO_INICIAL_NOMBRE=Dueño
DUENO_INICIAL_APELLIDO=Admin
DUENO_INICIAL_EMAIL=dueno@olimpos.local
DUENO_INICIAL_USERNAME=dueno
DUENO_INICIAL_PASSWORD=cambiar-esto-en-el-primer-ingreso


# --- CORS --------------------------------------------------------------------
# Orígenes que pueden llamar a la API desde un navegador.
# Ojo con la diferencia respecto del proyecto del profe: él deja allow_origins
# ["*"] porque su único frontend es Flet de escritorio, que NO es un navegador
# y por lo tanto no aplica CORS. Nuestra PWA sí corre en el navegador, así que
# acá la lista importa de verdad y va restringida.
# Separar con comas, sin espacios. 5173 = Vite en dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --- Cookies de sesión (solo afecta a la PWA en el navegador) ----------------
# La app Flet no usa cookies: se autentica con Authorization: Bearer.
#
# COOKIE_SECURE=true hace que el navegador mande la cookie SOLO por HTTPS.
# EN PRODUCCIÓN TIENE QUE SER true, sin excepción: en false la sesión viaja en
# texto plano y cualquiera en la misma red la lee. En desarrollo sobre
# http://localhost hay que dejarlo en false o el navegador nunca la manda.
COOKIE_SECURE=false

# /docs, /redoc y /openapi.json. En desarrollo true (las verificaciones cuentan
# endpoints con /openapi.json); EN PRODUCCIÓN false: exponen el mapa entero de
# la API a cualquiera. Arrancar además uvicorn con --no-server-header.
DOCS_PUBLICOS=true

# lax: el navegador no manda la cookie en POST originados por otro sitio.
# 'strict' es más duro pero deja al usuario deslogueado al llegar desde un
# link externo. La segunda capa (token CSRF) aplica en los dos casos.
COOKIE_SAMESITE=lax


# --- Envío de credenciales por email (opcional) -----------------------------
# Si SMTP_HOST queda vacío, el sistema NO falla: devuelve el texto del mensaje
# ya armado para que el personal lo copie y lo mande por WhatsApp. Ver
# notificaciones.py.
#
# Gmail exige una "contraseña de aplicación", no la del correo:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_DESDE=
SMTP_TIMEOUT=10

# Nombre que aparece en el mensaje de bienvenida.
NOMBRE_GIMNASIO=OlimpOS


# --- Videos tutoriales (demonio_videos.py) -----------------------------------
# Carpeta donde se guardan los videos (la del servidor FTP). Vacío = /videos
# en la raíz del repo.
VIDEOS_DIR=
# Canal oficial del gimnasio: @handle, URL del canal o id (UC...). Los links
# de otros canales no se descargan. Vacío = acepta cualquier video.
VIDEOS_CANAL_YOUTUBE=
# Cada cuántos minutos el demonio busca links nuevos.
VIDEOS_INTERVALO_MIN=10

# =============================================================================
# MERCADO PAGO — cobro con tarjeta desde la app del socio
# =============================================================================
# Con MP_ACCESS_TOKEN vacío el pago online queda deshabilitado: el endpoint
# responde 503 con un mensaje que manda al socio a recepción, en vez de
# fallar feo. No rompe nada tenerlo apagado.

# Panel de Mercado Pago → Tus integraciones → Credenciales.
# El token de PRUEBA alcanza para desarrollar (empieza con TEST-).
MP_ACCESS_TOKEN=

# Secreto del webhook, del mismo panel. Es lo que permite verificar que el
# aviso vino de Mercado Pago y no de cualquiera que descubra la URL. Sin
# esto, TODOS los avisos se rechazan — a propósito: preferimos no acreditar
# nada antes que acreditar cualquier cosa.
MP_WEBHOOK_SECRET=

# URL PÚBLICA donde Mercado Pago avisa que un pago cambió de estado.
# No puede ser 127.0.0.1: la llaman desde internet. En desarrollo:
#     ngrok http 8000
#     MP_URL_WEBHOOK=https://xxxx.ngrok-free.app/webhooks/mercadopago
# Vacío = no se manda notification_url y el pago nunca se confirma solo.
MP_URL_WEBHOOK=

# A dónde vuelve el socio después de pagar. Esta SÍ puede ser localhost:
# la abre el navegador de él, no Mercado Pago.
MP_URL_RETORNO=http://localhost:5173/mi-cuota

# Permite recorrer el flujo entero sin cuenta de Mercado Pago: crea el pago,
# devuelve una URL falsa y habilita un endpoint para acreditarlo a mano.
# Se IGNORA si hay MP_ACCESS_TOKEN cargado, para que nadie lo deje prendido
# en producción por olvido. NUNCA en producción.
MP_MODO_SIMULADO=false
