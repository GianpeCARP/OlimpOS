Ref: Socio_Patologia.id_patologia > Patologia.id_patologia
Ref: Profesor_Actividad.id_profesor > Profesor.id_profesor
Ref: Profesor_Actividad.id_actividad > Actividad.id_actividad

// --- Tipo 4: N:M ENRIQUECIDO CON HISTORIA -----------------------------------
