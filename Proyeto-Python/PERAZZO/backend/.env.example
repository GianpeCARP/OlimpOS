# Cadena de conexión a Neon (se copia desde el panel de Neon: Connection string)
# OJO: debe incluir sslmode=require, Neon exige conexiones cifradas.
DATABASE_URL=postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/nombre_db?sslmode=require

# Credenciales del usuario PROPIETARIO inicial (el seeder lo crea una sola vez)
ADMIN_INICIAL_EMAIL=propietario@gimnasio.com
ADMIN_INICIAL_PASSWORD=cambiar-esto-123
# DNI de relleno para la Persona del propietario inicial (opcional, default "00000000")
ADMIN_INICIAL_DNI=00000000

# Clave secreta para firmar los JWT (usar algo largo y aleatorio en producción)
JWT_SECRET_KEY=una-clave-secreta-larga-y-aleatoria
