// ============================================================================
// OlimpOS - Modelo de datos v3 (COMPLETO)
// Alineado con: Diagrama de Contexto + DFD Nivel 0, 1 y 2
// Normalizado hasta 3FN
// Pegar en https://dbdiagram.io
// ============================================================================

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

Enum estado_membresia {
  ACTIVA
  VENCIDA
  SUSPENDIDA
  CANCELADA
}

Enum estado_pago {
  CONFIRMADO
  PENDIENTE
  CANCELADO
  REEMBOLSADO
}

Enum estado_deuda {
  PENDIENTE
  PAGADA
  CONDONADA
}

Enum estado_turno {
  HABILITADO
  CANCELADO
}

Enum estado_reserva {
  RESERVADA
  CANCELADA_SOCIO
  CANCELADA_GIMNASIO
}

Enum estado_asignacion {
  ACTIVA
  FINALIZADA
  CANCELADA
}

Enum tipo_baja {
  VOLUNTARIA
  MORA
  ADMINISTRATIVA
}

Enum tipo_telefono {
  CELULAR
  FIJO
  EMERGENCIA
}

Enum accion_auditoria {
  ALTA
  MODIFICACION
  BAJA
  CONSULTA
  LOGIN
}

// ============================================================================
// BLOQUE 1: PERSONAS Y ACCESO
// Cubre DFD 1. Gestion_Socios (1.1 Area_Accesos, 1.2 Area_Dato)
// ============================================================================

Table Persona {
  id_persona int [pk, increment]
  dni varchar(20) [unique, not null]
  apellido varchar(100) [not null]
  nombre varchar(100) [not null]
  sexo varchar(20)
  email varchar(150) [unique]
  calle varchar(100)
  numero_calle varchar(10)
  localidad varchar(80)
  fecha_nacimiento date
  fecha_alta timestamp [default: `now()`]
  activo boolean [default: true]

  Note: '''
  SUPERTIPO. Todos los atributos comunes viven aca, NO repetidos en cada rol.
  1FN: nombre y apellido separados (atributos atomicos).
       Direccion descompuesta en calle/numero/localidad.
  3FN: evita que el DNI de una misma persona este cargado en 3 tablas distintas.
  '''
}

Table Telefono {
  id_telefono int [pk, increment]
  id_persona int [not null, ref: > Persona.id_persona]
  numero varchar(30) [not null]
  tipo tipo_telefono [default: 'CELULAR']

  Note: '''
  1FN: una persona puede tener varios telefonos. Guardarlos como
  "111-111, 222-222" en un varchar violaria la atomicidad.
  '''
}

Table Usuario {
  id_usuario int [pk, increment]
  id_persona int [unique, not null, ref: > Persona.id_persona]
  username varchar(50) [unique, not null]
  password_hash varchar(255) [not null]
  ultimo_acceso timestamp
  intentos_fallidos int [default: 0]
  bloqueado boolean [default: false]
  activo boolean [default: true]

  Note: 'DFD 1.1.2 Socio login -> Credenciales / Sesion iniciada'
}

Table Rol {
  id_rol int [pk, increment]
  nombre varchar(50) [unique, not null]
  descripcion varchar(150)

  Note: 'SOCIO, ENTRENADOR, NUTRICIONISTA, RECEPCIONISTA, DUENO'
}

Table Usuario_Rol {
  id_usuario int [pk, ref: > Usuario.id_usuario]
  id_rol int [pk, ref: > Rol.id_rol]
  fecha_asignacion date [default: `now()`]

  Note: '''
  PK compuesta. 2FN: fecha_asignacion depende de AMBAS partes de la clave
  (de cuando ESE usuario recibio ESE rol), no de una sola. Cumple.
  '''
}

// --- SUBTIPOS: solo atributos propios del rol ---

Table Dueno {
  id_dueno int [pk, increment]
  id_persona int [unique, not null, ref: > Persona.id_persona]
  porcentaje_participacion decimal(5,2)
}

Table Empleado {
  id_empleado int [pk, increment]
  id_persona int [unique, not null, ref: > Persona.id_persona]
  id_dueno int [ref: > Dueno.id_dueno]
  legajo varchar(20) [unique]
  fecha_ingreso date [not null]
  fecha_egreso date
  salario decimal(10,2)
  activo boolean [default: true]

  Note: 'id_dueno: el dueno tiene dominio sobre el personal (requisito del usuario).'
}

Table Entrenador {
  id_entrenador int [pk, increment]
  id_empleado int [unique, not null, ref: > Empleado.id_empleado]
  titulo varchar(100)
  especialidad varchar(100)
  matricula varchar(50)
}

Table Nutricionista {
  id_nutricionista int [pk, increment]
  id_empleado int [unique, not null, ref: > Empleado.id_empleado]
  titulo varchar(100)
  matricula varchar(50)
}

Table Recepcionista {
  id_recepcionista int [pk, increment]
  id_empleado int [unique, not null, ref: > Empleado.id_empleado]
  turno_laboral varchar(20)

  Note: 'Sin DFD propio, pero necesario: el dueno lo administra desde el sistema.'
}

Table Socio {
  id_socio int [pk, increment]
  id_persona int [unique, not null, ref: > Persona.id_persona]
  id_entrenador_a_cargo int [ref: > Entrenador.id_entrenador]
  numero_socio varchar(20) [unique]
  fecha_alta date [not null]
  objetivo varchar(150)
  observaciones text
  activo boolean [default: true]
}

Table Baja {
  id_baja int [pk, increment]
  id_socio int [not null, ref: > Socio.id_socio]
  fecha_baja date [not null]
  tipo tipo_baja
  motivo varchar(250)
  id_registrado_por int [ref: > Usuario.id_usuario]

  Note: '''
  DFD 1.1.3 Socio baja / DFD 6.3.2 Dueno consulta bajas.
  Tabla separada (no un booleano en Socio) porque un socio puede darse
  de baja y volver a inscribirse: es un HECHO con fecha, no un estado.
  '''
}

// ============================================================================
// BLOQUE 2: CUOTAS, PAGOS, DEUDAS, PROMOCIONES
// Cubre DFD 2. Gestion_Cuotas (2.1 Cuota, 2.2 Promocion, 2.3 Deuda)
// ============================================================================

Table Tipo_Membresia {
  id_tipo_membresia int [pk, increment]
  nombre varchar(50) [unique, not null]
  descripcion text
  duracion_dias int [not null]
  precio_actual decimal(10,2) [not null]
  activo boolean [default: true]

  Note: '''
  3FN: en el modelo anterior Membresia tenia (Tipo, Precio) y existia
  Tipo -> Precio, una dependencia transitiva. Al separar, el precio de
  un plan se actualiza en UNA sola fila.
  '''
}

Table Promocion {
  id_promocion int [pk, increment]
  id_dueno int [ref: > Dueno.id_dueno]
  nombre varchar(100) [not null]
  descripcion text
  porcentaje_descuento decimal(5,2)
  monto_fijo_descuento decimal(10,2)
  fecha_inicio date [not null]
  fecha_fin date [not null]
  activo boolean [default: true]

  Note: 'DFD 2.2: dueno crea (2.2.1), socio consulta (2.2.2), dueno modifica (2.2.3), dueno elimina (2.2.4)'
}

Table Membresia {
  id_membresia int [pk, increment]
  id_socio int [not null, ref: > Socio.id_socio]
  id_tipo_membresia int [not null, ref: > Tipo_Membresia.id_tipo_membresia]
  id_promocion int [ref: > Promocion.id_promocion]
  precio_pactado decimal(10,2) [not null]
  fecha_inicio date [not null]
  fecha_vencimiento date [not null]
  estado estado_membresia [default: 'ACTIVA']

  indexes {
    (id_socio, fecha_inicio) [unique]
    (estado, fecha_vencimiento)
  }
  Note: '''
  1:N con Socio -> historial de renovaciones. NO poner unique en id_socio solo.
  "Membresia vigente" es una CONSULTA:
     WHERE id_socio = ? AND estado = 'ACTIVA' AND CURRENT_DATE <= fecha_vencimiento

  precio_pactado NO viola 3FN aunque Tipo_Membresia ya tenga precio_actual:
  es un valor historico congelado al momento de la venta. Si manana sube la
  cuota, las membresias ya vendidas deben conservar su precio original.
  '''
}

Table Metodo_Pago {
  id_metodo_pago int [pk, increment]
  nombre varchar(50) [unique, not null]

  Note: 'EFECTIVO, DEBITO, CREDITO, TRANSFERENCIA, MERCADO_PAGO'
}

Table Pago {
  id_pago int [pk, increment]
  id_socio int [not null, ref: > Socio.id_socio]
  id_membresia int [ref: > Membresia.id_membresia]
  id_metodo_pago int [not null, ref: > Metodo_Pago.id_metodo_pago]
  monto decimal(10,2) [not null]
  fecha_pago timestamp [not null, default: `now()`]
  periodo_desde date
  periodo_hasta date
  es_adelanto boolean [default: false]
  estado estado_pago [default: 'CONFIRMADO']
  fecha_cancelacion timestamp
  numero_comprobante varchar(50) [unique]
  id_registrado_por int [ref: > Usuario.id_usuario]

  indexes {
    (id_socio, fecha_pago)
  }
  Note: '''
  DFD 2.1: pago (2.1.1), consulta (2.1.2), adelanto (2.1.3), cancela (2.1.4).
  Un pago NUNCA se borra fisicamente: se marca estado = CANCELADO.
  Metodo_pago salio de Membresia porque pertenece al pago, no al plan.
  '''
}

Table Deuda {
  id_deuda int [pk, increment]
  id_socio int [not null, ref: > Socio.id_socio]
  id_membresia int [ref: > Membresia.id_membresia]
  monto decimal(10,2) [not null]
  fecha_generacion date [not null]
  fecha_vencimiento date
  estado estado_deuda [default: 'PENDIENTE']
  generada_automaticamente boolean [default: true]
  id_pago_cancelatorio int [ref: > Pago.id_pago]
  observaciones varchar(250)

  indexes {
    (id_socio, estado)
  }
  Note: '''
  DFD 2.3: socio consulta (2.3.1), dueno modifica, dueno elimina (2.3.2).

  GENERACION AUTOMATICA (job diario):
  Para cada Membresia con estado ACTIVA y fecha_vencimiento < CURRENT_DATE
  que no tenga Pago CONFIRMADO cubriendo el periodo:
     1. UPDATE Membresia SET estado = VENCIDA
     2. INSERT Deuda (monto = precio_pactado, generada_automaticamente = true)
  Al registrarse un Pago que cubra la deuda:
     UPDATE Deuda SET estado = PAGADA, id_pago_cancelatorio = <nuevo pago>
  '''
}

// ============================================================================
// BLOQUE 3: SALUD Y SEGUIMIENTO FISICO
// Cubre DFD 3.2 Area_Peso
// ============================================================================

Table Registro_Salud {
  id_registro_salud int [pk, increment]
  id_socio int [not null, ref: > Socio.id_socio]
  fecha date [not null]
  peso decimal(5,2)
  altura decimal(3,2)
  grasa_corporal decimal(4,2)
  masa_muscular decimal(5,2)
  observaciones text
  id_registrado_por int [ref: > Usuario.id_usuario]

  indexes {
    (id_socio, fecha) [unique]
  }
  Note: '''
  HISTORICO 1:N. El unique (id_socio, fecha) garantiza lo que buscabas:
  el socio NO puede tener dos pesos vigentes el mismo dia.
  Pero conserva la progresion, que es el producto principal del gimnasio.

  "Peso actual" es una consulta, no una tabla:
     SELECT * FROM Registro_Salud WHERE id_socio = ?
     ORDER BY fecha DESC LIMIT 1;

  Borrar la fila anterior al registrar una nueva = anomalia de borrado.
  '''
}

Table Patologia {
  id_patologia int [pk, increment]
  nombre varchar(100) [unique, not null]
  descripcion text

  Note: '3FN: catalogo. Evita "diabetes" escrito de 5 formas distintas.'
}

Table Socio_Patologia {
  id_socio int [pk, ref: > Socio.id_socio]
  id_patologia int [pk, ref: > Patologia.id_patologia]
  fecha_diagnostico date
  observaciones text

  Note: '''
  1FN: rompe el varchar(250) multivaluado del modelo anterior, donde se
  guardaba "diabetes, hipertension, hernia" en una sola celda.
  2FN: fecha_diagnostico depende de la clave completa (ESE socio + ESA patologia).
  '''
}

// ============================================================================
// BLOQUE 4: RUTINAS
// Cubre DFD 3. Gestion_Rutinas (3.1 Area_Rutina)
// ============================================================================

Table Ejercicio {
  id_ejercicio int [pk, increment]
  nombre varchar(100) [unique, not null]
  grupo_muscular varchar(50) [not null]
  descripcion text
  url_video varchar(255)
  requiere_maquina boolean [default: false]

  Note: '3FN: grupo_muscular depende del ejercicio, no de la rutina.'
}

Table Rutina {
  id_rutina int [pk, increment]
  id_entrenador int [not null, ref: > Entrenador.id_entrenador]
  nombre varchar(100) [not null]
  objetivo varchar(100)
  nivel varchar(20)
  dias_por_semana int
  fecha_creacion date [default: `now()`]
  activo boolean [default: true]

  Note: 'DFD 3.1: crea (3.1.1), modifica (3.1.2), consulta socio (3.1.3), consulta entrenador (3.1.4), elimina (3.1.5)'
}

Table Rutina_Ejercicio {
  id_rutina_ejercicio int [pk, increment]
  id_rutina int [not null, ref: > Rutina.id_rutina]
  id_ejercicio int [not null, ref: > Ejercicio.id_ejercicio]
  dia int [not null]
  orden int [not null]
  series int
  repeticiones varchar(20)
  peso_sugerido decimal(6,2)
  descanso_segundos int
  observaciones varchar(200)

  indexes {
    (id_rutina, dia, orden) [unique]
  }
  Note: '''
  1FN: una rutina tiene muchos ejercicios. Guardarlos como lista en un
  campo de Rutina violaria la atomicidad (mismo caso que Compositor/Obras
  del apunte). Se "aplana" con una fila por ejercicio.
  '''
}

Table Asignacion_Rutina {
  id_asignacion_rutina int [pk, increment]
  id_socio int [not null, ref: > Socio.id_socio]
  id_rutina int [not null, ref: > Rutina.id_rutina]
  id_entrenador int [ref: > Entrenador.id_entrenador]
  fecha_inicio date [not null]
  fecha_fin date
  estado estado_asignacion [default: 'ACTIVA']

  indexes {
    (id_socio, id_rutina, fecha_inicio) [unique]
    (id_socio, estado)
  }
  Note: '''
  PK subrogada. El modelo anterior tenia id_cliente como PK unica: eso
  permitia UNA rutina por socio en toda su vida, imposible de sostener
  cuando las rutinas se dividen por grupo muscular.
  '''
}

// ============================================================================
// BLOQUE 5: DIETAS
// Cubre DFD 4. Gestion_Dietas (4.1 Area_Dietas, 4.2 Area_DietasAsignadas)
// ============================================================================

Table Dieta {
  id_dieta int [pk, increment]
  id_nutricionista int [not null, ref: > Nutricionista.id_nutricionista]
  nombre varchar(100) [not null]
  objetivo varchar(100)
  calorias_diarias int
  descripcion text
  fecha_creacion date [default: `now()`]
  activo boolean [default: true]

  Note: 'DFD 4.1: crea (4.1.1), modifica (4.1.2), elimina (4.1.3), asigna (4.1.4)'
}

Table Comida {
  id_comida int [pk, increment]
  id_dieta int [not null, ref: > Dieta.id_dieta]
  dia int
  momento varchar(30)
  descripcion text [not null]
  calorias int

  Note: '1FN: una dieta tiene varias comidas -> tabla propia, no lista en un campo.'
}

Table Asignacion_Dieta {
  id_asignacion_dieta int [pk, increment]
  id_socio int [not null, ref: > Socio.id_socio]
  id_dieta int [not null, ref: > Dieta.id_dieta]
  id_nutricionista int [ref: > Nutricionista.id_nutricionista]
  fecha_inicio date [not null]
  fecha_fin date
  estado estado_asignacion [default: 'ACTIVA']
  observaciones text

  indexes {
    (id_socio, estado)
  }
  Note: '''
  Almacen "Dietas asignadas" del DFD 4.2.
  N:M real: una misma dieta base sirve para varios socios, y un socio
  cambia de dieta con el tiempo.
  '''
}

// ============================================================================
// BLOQUE 6: TURNOS Y ASISTENCIA
// Cubre DFD 5. Gestion_Turnos (5.1 Area_Turnos, 5.2 Area_Asistencia)
// ============================================================================

Table Turno {
  id_turno int [pk, increment]
  fecha date [unique, not null]
  cupo_maximo int [not null]
  estado estado_turno [default: 'HABILITADO']
  id_entrenador_a_cargo int [ref: > Entrenador.id_entrenador]
  motivo_cancelacion varchar(200)
  observaciones varchar(200)

  Note: '''
  MODELO DE ACCESO LIBRE 24 HS (requisito del usuario).
  Un Turno = un DIA habilitado con cupo, no una clase con horario fijo.
  El socio reserva el dia y entra cuando quiere.

  DFD 5.1: socio consulta (5.1.1), socio modifica (5.1.2), dueno modifica (5.1.3).
  "Modificar el turno" = cambiar la reserva de dia.

  SI MAS ADELANTE agregan clases con horario (spinning, funcional):
  agregar tabla Actividad y las columnas hora_inicio / hora_fin aca,
  y sacar el unique de fecha.
  '''
}

Table Reserva {
  id_reserva int [pk, increment]
  id_turno int [not null, ref: > Turno.id_turno]
  id_socio int [not null, ref: > Socio.id_socio]
  fecha_reserva timestamp [default: `now()`]
  estado estado_reserva [default: 'RESERVADA']
  fecha_cancelacion timestamp
  id_cancelado_por int [ref: > Usuario.id_usuario]

  indexes {
    (id_turno, id_socio) [unique]
  }
  Note: '''
  DFD 5.2: socio reserva (5.2.1), socio cancela (5.2.2), dueno cancela (5.2.3).
  El unique (id_turno, id_socio) impide reservar dos veces el mismo dia.
  Cupo disponible = cupo_maximo - COUNT(reservas con estado RESERVADA).
  '''
}

Table Asistencia {
  id_asistencia int [pk, increment]
  id_socio int [not null, ref: > Socio.id_socio]
  id_reserva int [ref: > Reserva.id_reserva]
  fecha_hora_ingreso timestamp [not null]
  fecha_hora_egreso timestamp
  id_registrado_por int [ref: > Usuario.id_usuario]

  indexes {
    (id_socio, fecha_hora_ingreso)
  }
  Note: '''
  1:N con Reserva (SIN unique): el socio puede entrar y salir VARIAS VECES
  en el mismo dia, como pediste.
  id_reserva nullable: permite registrar ingresos sin reserva previa.
  '''
}

// ============================================================================
// BLOQUE 7: CONSULTAS CRUZADAS ENTRE PROFESIONALES
// ============================================================================

Table Consulta_Rutina_Nutricionista {
  id_consulta int [pk, increment]
  id_nutricionista int [not null, ref: > Nutricionista.id_nutricionista]
  id_rutina int [not null, ref: > Rutina.id_rutina]
  fecha_consulta timestamp [default: `now()`]

  Note: '''
  PK subrogada. Con la PK compuesta (id_nutricionista, id_rutina) el
  nutricionista podia consultar esa rutina UNA sola vez en la historia,
  porque la segunda fila violaba la clave primaria.
  '''
}

Table Consulta_Dieta_Entrenador {
  id_consulta int [pk, increment]
  id_entrenador int [not null, ref: > Entrenador.id_entrenador]
  id_dieta int [not null, ref: > Dieta.id_dieta]
  fecha_consulta timestamp [default: `now()`]
}

// ============================================================================
// BLOQUE 8: AUDITORIA
// Soporta DFD 6. Gestion_Consultas y todas las operaciones modificar/eliminar
// ============================================================================

Table Auditoria {
  id_auditoria int [pk, increment]
  id_usuario int [ref: > Usuario.id_usuario]
  entidad varchar(50) [not null]
  id_entidad int
  accion accion_auditoria [not null]
  fecha timestamp [default: `now()`]
  detalle text
  ip varchar(45)

  indexes {
    (entidad, id_entidad)
    (fecha)
  }
  Note: 'Registra quien hizo que y cuando. Reemplaza el almacen "Registros" del DFD 1.1.'
}
