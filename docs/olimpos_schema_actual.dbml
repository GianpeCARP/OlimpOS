Ref: "Comida"."id_dieta" > "Dieta"."id_dieta"
Ref: "Congelamiento"."id_membresia" > "Membresia"."id_membresia"
Ref: "Contacto_Emergencia"."id_persona" > "Persona"."id_persona"
Ref: "Dieta"."id_nutricionista" > "Nutricionista"."id_nutricionista"
Ref: "Dueno"."id_persona" > "Persona"."id_persona"
Ref: "Empleado"."id_persona" > "Persona"."id_persona"
Ref: "Empleado"."id_sede" > "Sede"."id_sede"
Ref: "Entrenador"."id_empleado" > "Empleado"."id_empleado"
Ref: "Horario_Actividad"."id_actividad" > "Actividad"."id_actividad"
Ref: "Horario_Actividad"."id_entrenador_a_cargo" > "Entrenador"."id_entrenador"
Ref: "Horario_Actividad"."id_sede" > "Sede"."id_sede"
Ref: "Horario_Actividad".("id_profesor", "id_actividad") > "Profesor_Actividad".("id_profesor", "id_actividad")
Ref: "Inscripcion_Actividad"."id_plan_actividad" > "Plan_Actividad"."id_plan_actividad"
Ref: "Inscripcion_Actividad"."id_socio" > "Socio"."id_socio"
Ref: "Membresia"."id_socio" > "Socio"."id_socio"
Ref: "Membresia"."id_tipo_membresia" > "Tipo_Membresia"."id_tipo_membresia"
Ref: "Nutricionista"."id_empleado" > "Empleado"."id_empleado"
Ref: "Pago"."id_inscripcion" > "Inscripcion_Actividad"."id_inscripcion"
Ref: "Pago"."id_membresia" > "Membresia"."id_membresia"
Ref: "Pago"."id_promocion" > "Promocion"."id_promocion"
Ref: "Pago"."id_sede" > "Sede"."id_sede"
Ref: "Pago"."id_socio" > "Socio"."id_socio"
Ref: "Plan_Actividad"."id_actividad" > "Actividad"."id_actividad"
Ref: "Profesor"."id_empleado" > "Empleado"."id_empleado"
Ref: "Profesor_Actividad"."id_actividad" > "Actividad"."id_actividad"
Ref: "Profesor_Actividad"."id_profesor" > "Profesor"."id_profesor"
Ref: "Promocion"."id_dueno" > "Dueno"."id_dueno"
Ref: "Promocion".("id_sede", "id_dueno") > "Sede".("id_sede", "id_dueno")
Ref: "Recepcionista"."id_empleado" > "Empleado"."id_empleado"
Ref: "Recepcionista"."id_franja_laboral" > "Franja_Laboral"."id_franja_laboral"
Ref: "Registro_Comida"."id_comida" > "Comida"."id_comida"
Ref: "Registro_Comida"."id_socio" > "Socio"."id_socio"
Ref: "Registro_Ejercicio"."id_ejercicio" > "Ejercicio"."id_ejercicio"
Ref: "Registro_Ejercicio"."id_socio" > "Socio"."id_socio"
Ref: "Registro_Salud"."id_socio" > "Socio"."id_socio"
Ref: "Reserva"."id_inscripcion" > "Inscripcion_Actividad"."id_inscripcion"
Ref: "Reserva"."id_pago" > "Pago"."id_pago"
Ref: "Reserva"."id_socio" > "Socio"."id_socio"
Ref: "Reserva"."id_turno" > "Turno"."id_turno"
Ref: "Rutina"."id_entrenador" > "Entrenador"."id_entrenador"
Ref: "Rutina_Ejercicio"."id_ejercicio" > "Ejercicio"."id_ejercicio"
Ref: "Rutina_Ejercicio"."id_rutina" > "Rutina"."id_rutina"
Ref: "Sede"."id_dueno" > "Dueno"."id_dueno"
Ref: "Socio"."id_persona" > "Persona"."id_persona"
