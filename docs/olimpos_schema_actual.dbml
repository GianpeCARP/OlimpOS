Ref: "Telefono"."id_persona" > "Persona"."id_persona"
Ref: "Turno"."id_actividad" > "Actividad"."id_actividad"
Ref: "Turno"."id_entrenador_a_cargo" > "Entrenador"."id_entrenador"
Ref: "Turno"."id_horario_actividad" > "Horario_Actividad"."id_horario_actividad"
Ref: "Turno"."id_sede" > "Sede"."id_sede"
